{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "outDir": "dist",
    "rootDir": ".",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["hardhat/types", "mocha", "chai", "node"]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist", "artifacts", "cache", "typechain-types"]
}
