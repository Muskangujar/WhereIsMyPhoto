# Serper API key for Google Lens reverse-image search
# Get one at https://serper.dev
SERPER_API_KEY=your_serper_api_key_here

# Blockchain (Polygon Amoy testnet) — only needed for --network amoy
# Never commit a real private key. Use a throwaway wallet.
PRIVATE_KEY=your_throwaway_wallet_private_key_here
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
